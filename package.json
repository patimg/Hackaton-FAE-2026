{
  "name": "fae-documentos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "auth:google": "tsx scripts/get-google-tokens.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "sync:gmail": "node --conditions=react-server --import tsx scripts/sync-gmail.ts",
    "dev:whatsapp": "tsx scripts/whatsapp-listener.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@whiskeysockets/baileys": "6.7.22",
    "file-type": "22.1.1",
    "googleapis": "182.0.0",
    "libphonenumber-js": "1.13.13",
    "next": "16.3.6",
    "pino": "10.3.1",
    "qrcode-terminal": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.0",
    "supabase": "2.117.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
