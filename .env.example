# Aplicación y Supabase
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Santiago
DEFAULT_PHONE_COUNTRY=CL
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPERATOR_USER_ID=
DATABASE_URL=

# Almacenamiento
STORAGE_PROVIDER=local
LOCAL_FILES_DIR=./.data/files
STAGING_DIR=./.data/staging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# IA
AI_PROVIDER=deterministic
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=10000

# Ingestión de workers externos
INGEST_API_TOKEN=

# Gmail
GMAIL_USER=
GMAIL_ACCOUNT_ID=
GMAIL_QUERY=is:unread
GMAIL_MAX_MESSAGES=25
GMAIL_POLL_INTERVAL_MS=30000

# WhatsApp no oficial
WHATSAPP_AUTH_DIR=./.data/whatsapp-auth
WHATSAPP_SOURCE_ACCOUNT_ID=demo-whatsapp
WHATSAPP_INGEST_URL=http://127.0.0.1:3000/api/v1/ingest
WHATSAPP_INGEST_EMAIL=
WHATSAPP_INGEST_PASSWORD=

# Bootstrap local de Auth
DEMO_AUTH_EMAIL=operadora@example.test
DEMO_AUTH_PASSWORD=

# Límites
MAX_FILES_PER_MESSAGE=5
MAX_FILE_BYTES=5242880
MAX_TOTAL_ATTACHMENT_BYTES=15728640
MAX_REQUEST_BYTES=16777216
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.80
