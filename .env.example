# Solo para ejecutar pruebas E2E locales
LOCAL_OPERATOR_EMAIL=
LOCAL_OPERATOR_PASSWORD=

# Límites
MAX_FILES_PER_MESSAGE=5
MAX_FILE_BYTES=5242880
MAX_TOTAL_ATTACHMENT_BYTES=15728640
MAX_REQUEST_BYTES=16777216
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.80
