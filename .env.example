# Aplicación y Supabase local
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Santiago
DEFAULT_PHONE_COUNTRY=CL
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPERATOR_USER_ID=
DATABASE_URL=

# Google Drive (obligatorio)
STORAGE_PROVIDER=google-drive
STAGING_DIR=./.data/staging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Búsqueda y clasificación con IA (obligatorio)
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=10000

# Autenticación interna de conectores
INGEST_API_TOKEN=

# Gmail
GMAIL_USER=
GMAIL_ACCOUNT_ID=
GMAIL_QUERY=is:unread category:primary
GMAIL_START_DATE=
GMAIL_MAX_MESSAGES=25
GMAIL_POLL_INTERVAL_MS=30000

# WhatsApp Web (Baileys)
WHATSAPP_AUTH_DIR=./.data/whatsapp-auth
WHATSAPP_SOURCE_ACCOUNT_ID=
