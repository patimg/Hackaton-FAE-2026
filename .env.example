# Fases 1 y 2: configuración consumida por la aplicación. Sin secretos reales.
# npm run demo:setup prepara .env.local desde Supabase local y crea Auth.
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Santiago
DEFAULT_PHONE_COUNTRY=CL
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPERATOR_USER_ID=
STORAGE_PROVIDER=local
AI_PROVIDER=deterministic
# Para APP_MODE=live: AI_PROVIDER=openai, AI_MODEL y AI_API_KEY (solo servidor).
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=10000
LOCAL_FILES_DIR=./.data/files
STAGING_DIR=./.data/staging

# Solo scripts de seed/pruebas locales. demo:setup obtiene/genera estos valores.
DATABASE_URL=
DEMO_AUTH_EMAIL=operadora@example.test
DEMO_AUTH_PASSWORD=

# Variables de Drive, LLM y autenticación n8n se añadirán cuando se implemente su fase.
# No se requieren credenciales externas para demo.

# Límites de ingestión (bytes) y umbral de clasificación simulada
MAX_FILES_PER_MESSAGE=5
MAX_FILE_BYTES=5242880
MAX_TOTAL_ATTACHMENT_BYTES=15728640
MAX_REQUEST_BYTES=16777216
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.80
